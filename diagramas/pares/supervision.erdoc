entity Empleado {
    rut key
    nombre
    cargo
}

entity Departamento {
    id key
    nombre
    piso
}

entity Proyecto {
    id key
    nombre
    presupuesto
}

relation Supervisa(Empleado: [Jefe 1, Subordinado N])

relation Trabaja_en(Empleado N, Departamento 1!)

relation Participa(Empleado M, Proyecto N)
